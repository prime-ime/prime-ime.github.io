---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { SITE, type Section } from '../config';
import { href, t, type Lang } from '../i18n/ui';
interface Props { lang?: Lang; title?: string; description?: string; section?: Section; noindex?: boolean }
const { lang = 'zh', title, description = SITE.description[lang], section = 'home', noindex = false } = Astro.props;
const u = t(lang);
const pageTitle = title ? `${title} · PRIME Lab` : `PRIME Lab · ${SITE.name[lang]}`;
const canonical = new URL(Astro.url.pathname, SITE.website).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10263f" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Inter-Regular.woff" as="font" type="font/woff" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="PRIME Lab" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={`${SITE.website}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'ResearchOrganization', name: SITE.labName, alternateName: SITE.name.zh, url: SITE.website, description, parentOrganization: { '@type': 'CollegeOrUniversity', name: SITE.university[lang] }, sameAs: [SITE.github] }).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">{u.skip}</a>
    <Header lang={lang} section={section} />
    <main id="main" data-pagefind-body={noindex ? undefined : true} tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-main">
        <div><a class="footer-brand" href={href(lang)}>PRIME<span> Lab</span><span class="dot">.</span></a><p>{SITE.name[lang]}<br />{SITE.university[lang]}</p></div>
        <div class="footer-mission">Predictive Research in<br />Industrial Modeling and Energy</div>
        <div class="footer-links"><a href={href(lang, 'research')}>{u.research} ↗</a><a href={href(lang, 'join')}>{u.join} ↗</a><a href={SITE.github}>GitHub ↗</a></div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} PRIME Lab</span><a href="https://github.com/fjd2004711/scholar-lite">Built on Scholar-Lite · MIT</a><span>XINJIANG UNIVERSITY</span></div>
    </footer>
  </body>
</html>
<script>
  // Animate only once, without hiding content before JS or requiring animation to read it.
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  if (!reducedMotion.matches && 'IntersectionObserver' in window) {
    const animations = new Set<Animation>();
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        const animation = entry.target.animate(
          [{ opacity: .4, transform: 'translateY(16px)' }, { opacity: 1, transform: 'translateY(0)' }],
          { duration: 550, easing: 'cubic-bezier(.2,.7,.3,1)' }
        );
        animations.add(animation);
        animation.onfinish = () => animations.delete(animation);
      }
    }, { threshold: .08 });
    document.querySelectorAll('[data-reveal]').forEach(element => observer.observe(element));
    reducedMotion.addEventListener('change', event => {
      if (!event.matches) return;
      observer.disconnect();
      animations.forEach(animation => animation.cancel());
      animations.clear();
    });
  }
</script>
