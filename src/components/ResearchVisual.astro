---
/** Lightweight, decorative diagrams: conceptual research themes, never experimental data. */
interface Props { theme: string }
const { theme } = Astro.props;
const waves = Array.from({ length: 7 }, (_, row) => Array.from({ length: 45 }, (_, col) => {
  const x = 20 + col * 7;
  const y = 77 + row * 9 + Math.sin(col * .19 + row * .3) * 18;
  return `${col ? 'L' : 'M'}${x},${y.toFixed(1)}`;
}).join(' '));
---
<svg class="research-visual" viewBox="0 0 350 180" fill="none" aria-hidden="true">
  <path d="M20 150H330M20 30V150" class="diagram-grid"/>
  {theme === 'industrial-energy' ? <>
    <path d="M67 61H173V121H280M67 121H173V61H280M67 61V121M280 61V121" class="diagram-line"/>
    {[{x:67,y:61},{x:67,y:121},{x:173,y:61},{x:173,y:121},{x:280,y:61},{x:280,y:121}].map(({x,y},i) => <g><rect x={x-15} y={y-15} width="30" height="30" rx="3" class:list={['diagram-node', {'diagram-node-accent':i === 2}]}/><circle cx={x} cy={y} r="3" fill="currentColor"/></g>)}
    <path d="m115 57 5 4-5 4m111 52 5 4-5 4" class="diagram-line"/>
  </> : theme === 'deep-forecasting' ? <>
    <path d="M20 119L43 105L62 117L82 72L103 87L127 101L148 61L168 75L191 50L215 65" class="diagram-line"/>
    <path d="M215 65Q244 100 267 50T328 40L328 83Q294 65 267 87T215 65" class="diagram-area"/>
    <path d="M215 65Q244 100 267 60T328 60" class="diagram-prediction"/>
    <path d="M215 30V150" class="diagram-grid" stroke-dasharray="3 5"/><circle cx="215" cy="65" r="4" fill="currentColor"/>
  </> : <>
    <g class="diagram-line">{waves.map(d => <path d={d}/>)}</g>
    <circle cx="175" cy="90" r="40" class="diagram-orbit"/><circle cx="175" cy="90" r="55" class="diagram-orbit" stroke-dasharray="2 6"/>
    <circle cx="175" cy="90" r="5" fill="currentColor"/>
  </>}
</svg>
