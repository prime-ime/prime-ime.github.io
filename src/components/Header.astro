---
import { SITE, sections, type Section } from '../config';
import { href, t, type Lang } from '../i18n/ui';
import { Search, Menu, ArrowUpRight } from 'lucide-react';
interface Props { lang: Lang; section?: Section }
const { lang, section = 'home' } = Astro.props;
const u = t(lang);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={href(lang)} aria-label={`${SITE.labName} ${u.home}`}>
      <svg class="brand-mark" width="35" height="38" viewBox="0 0 35 38" aria-hidden="true"><path d="M3 32V6h14a9 9 0 0 1 0 18h-7" fill="none" stroke="currentColor" stroke-width="5"/><path d="m14 34 18-18" stroke="#75e3c2" stroke-width="5"/></svg>
      <span>PRIME<span class="brand-lab"> Lab</span><small>{SITE.university[lang]}</small></span>
    </a>
    <nav class="desktop-nav" aria-label={u.menu}>
      {(['home', ...sections.filter(s => s !== 'search')] as Section[]).map(s => <a href={href(lang, s === 'home' ? '' : s)} aria-current={section === s ? 'page' : undefined} class:list={{ 'nav-join': s === 'join' }}>{u[s]}{s === 'join' && <ArrowUpRight size={14} />}</a>)}
    </nav>
    <div class="header-tools">
      <a class="search-link" href={href(lang, 'search')} aria-label={u.search}><Search size={19} /></a>
      <button id="menu-toggle" class="menu-toggle" aria-label={u.menu} aria-expanded="false" aria-controls="mobile-nav"><Menu size={22} /></button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav container" aria-label={u.menu}>
    {(['home', ...sections] as Section[]).map(s => <a href={href(lang, s === 'home' ? '' : s)} aria-current={section === s ? 'page' : undefined}>{u[s]}<span aria-hidden="true">↗</span></a>)}
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const nav = document.querySelector<HTMLElement>('#mobile-nav');
  // Progressive enhancement: without JS the mobile navigation remains available.
  document.documentElement.classList.add('js');
  function close() { toggle?.setAttribute('aria-expanded', 'false'); nav?.classList.remove('is-open'); }
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('is-open', open); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); } });
  document.addEventListener('click', e => { if (!(e.target instanceof Node) || !nav?.contains(e.target) && !toggle?.contains(e.target)) close(); });
  matchMedia('(min-width: 1100px)').addEventListener('change', e => { if (e.matches) close(); });
</script>
