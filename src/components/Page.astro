---
import Layout from '../layouts/Layout.astro';
import Home from './Home.astro';
import ResearchCards from './ResearchCards.astro';
import PublicationItem from './PublicationItem.astro';
import TeamCard from './TeamCard.astro';
import EmptyState from './EmptyState.astro';
import JoinContent from '../content/join.md';
import { SITE, type Section } from '../config';
import { href, t, type Lang } from '../i18n/ui';
import { getContent } from '../lib/content';
import { ArrowUpRight } from 'lucide-react';
interface Props { lang: Lang; section: Section }
const { lang, section } = Astro.props;
const u = t(lang);
const data = await getContent(lang);
const groups = [{role:'Faculty', label:u.faculty}, {role:'PhD Student', label:u.phd}, {role:'Master Student', label:u.master}, {role:'Alumni', label:u.alumni}];
const intros = {home:'', research:u.researchIntro,publications:u.publicationsIntro,people:u.peopleIntro,projects:u.projectsIntro,news:u.newsIntro,join:u.joinIntro,search:u.searchIntro};
const years = [...new Set(data.publications.map(p => p.data.year))];
---
<Layout lang={lang} title={section === 'home' ? undefined : u[section]} section={section} description={section === 'home' ? undefined : intros[section]} noindex={section === 'search'}>
  {section === 'home' ? <Home lang={lang}/> : <>
    <section class="page-heading"><div class="container"><a class="breadcrumb" href={href(lang)}>PRIME LAB <span>/</span></a><p class="eyebrow">{section === 'join' ? 'JOIN US' : section.toUpperCase()}</p><h1>{u[section]}</h1><p class="page-intro">{intros[section]}</p></div></section>
    <div class="container page-body">
      {section === 'research' && <><ResearchCards entries={data.research} lang={lang}/><div class="research-note"><span class="eyebrow">OUR PERSPECTIVE</span><h2>{'从问题出发，让方法回到场景。'}</h2><p>{'以工业能源系统为背景，联合考虑时序数据、物理规律与运行条件，研究建模和预测中的关键问题。'}</p></div></>}
      {section === 'publications' && <>
        {data.publications.length > 0 && <div class="publication-toolbar"><nav aria-label={'按年份浏览'}>{years.map(year => <a href={`#year-${year}`}>{year}</a>)}</nav><a class="text-link" href="/publications.bib" download>{u.download} ↓</a></div>}
        {years.map(year => <section class="year-group" id={`year-${year}`}><h2>{year}</h2><div>{data.publications.filter(p => p.data.year === year).map(entry => <PublicationItem lang={lang} entry={entry}/>)}</div></section>)}
        {!data.publications.length && <EmptyState lang={lang} title={u.emptyPapers} body={u.emptyPapersBody}/>}
      </>}
      {section === 'people' && <div class="people-groups">{groups.map(g => { const members = data.team.filter(m => m.data.role === g.role); return <section><div class="group-heading"><h2>{g.label}</h2>{members.length > 0 && <span>{String(members.length).padStart(2,'0')}</span>}</div>{members.length ? <div class="team-grid">{members.map(member => <TeamCard member={member} lang={lang}/>)}</div> : <p class="group-empty">{u.emptyPeople} <span>— {u.updatedSoon}</span></p>}</section>; })}</div>}
      {section === 'projects' && <>{data.projects.length ? <div class="project-list">{data.projects.map((p,i) => <article><span class="project-no">{String(i+1).padStart(2,'0')}</span><div><span class="eyebrow">{p.data.status}</span><h2><a href={href(lang, `projects/${p.data.translationKey}`)}>{p.data.title}</a></h2><p>{p.data.description}</p><div class="resource-links"><a href={href(lang, `projects/${p.data.translationKey}`)}>查看项目详情 →</a></div></div><a class="icon-link" href={href(lang, `projects/${p.data.translationKey}`)} aria-label={`${u.learn}: ${p.data.title}`}><ArrowUpRight size={24}/></a></article>)}</div> : <EmptyState lang={lang} title={u.emptyProjects} body={u.emptyProjectsBody}/>}<div class="resource-banner"><div><h2>{u.openSource}</h2><p>{u.openSourceBody}</p></div><a class="text-link" href={SITE.github}>GitHub <ArrowUpRight size={18}/></a></div></>}
      {section === 'news' && <>{data.news.length ? <div class="news-list">{data.news.map(n => <a href={href(lang, `news/${n.data.translationKey}`)}><time datetime={n.data.date.toISOString()}>{n.data.date.toISOString().slice(0,10)}</time><div><span class="eyebrow">{n.data.category}</span><h2>{n.data.title}</h2><p>{n.data.summary}</p></div><ArrowUpRight size={20}/></a>)}</div> : <EmptyState lang={lang} title={u.emptyNews} body={u.emptyNewsBody}/>}</>}
      {section === 'join' && <div class="join-content">
        <div class="prose join-prose"><JoinContent /></div>
        <aside class="contact-panel"><span class="eyebrow">LET’S CONNECT</span><h2>{u.contact}</h2>
          <dl><dt>指导教师</dt><dd><a href={SITE.advisor.profile}>{SITE.advisor.name} · 查看导师介绍 →</a></dd><dt>所在学院</dt><dd>{SITE.university[lang]} · {SITE.advisor.department}</dd><dt>{u.email}</dt><dd>{SITE.email ? <a href={`mailto:${SITE.email}`}>{SITE.email}</a> : u.unannounced}</dd>{SITE.address[lang] && <><dt>{u.address}</dt><dd>{SITE.address[lang]}</dd></>}</dl>
          {SITE.email && <a class="button button-dark" href={`mailto:${SITE.email}`}>邮件联系导师<ArrowUpRight size={17}/></a>}
        </aside>
      </div>}
      {section === 'search' && <div class="search-panel"><div id="search"></div><noscript>{'搜索需要 JavaScript。也可通过导航栏直接浏览所有栏目。'}</noscript></div>}
    </div>
  </>}
  {section === 'search' && <>
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <script is:inline src="/pagefind/pagefind-ui.js"></script>
    <script is:inline >
      if (window.PagefindUI) new window.PagefindUI({element:'#search', showImages:false, showSubResults:true, translations:{placeholder:'搜索研究、论文、成员…',search_label:'站内搜索',clear_search:'清除',zero_results:'未找到“[SEARCH_TERM]”',one_result:'找到 [COUNT] 个结果',many_results:'找到 [COUNT] 个结果',searching:'正在搜索…',load_more:'加载更多'}});
      else document.querySelector('#search').textContent = '搜索暂时不可用，请通过导航栏浏览网站。';
    </script>
  </>}
</Layout>
